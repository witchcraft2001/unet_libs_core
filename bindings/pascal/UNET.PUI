{ ==========================================================================
  GENERATED FILE - DO NOT EDIT.
  Source: abi/unet_abi.toml in unet_libs_core. Regenerate with
  tools/gen_bindings.py gen --target pascal.
  ========================================================================== }

{
  UNET - universal network DLL contract (libman 1.3 / L1)
  Shared ABI for UNETESP.DLL (ESP8266 / ESP-AT) and the future
  UNETRTL.DLL (RTL8019A). One interface, swappable backend.

  Consumers (asm / C / Pascal) load a backend DLL through libman 1.3
  (l_load / l_call / l_free) and drive the network through the numbered
  functions below. This file is the single source of truth for the
  function numbers, register ABI, error codes, capability bits, GETINFO
  fields and options. It is FROZEN: new capabilities extend the reserved
  slots and the caps bitmask, never renumber existing functions.

  -----------------------------------------------------------------------
  Calling convention (libman l_call):
    Consumer: HL = handle, B = function number, then CALL l_call.
    Arguments are passed ONLY in A, DE, IX, IY (HL and BC are consumed by
    the libman dispatcher). Results come back in A, DE, IX, IY.
    Every UNET function returns its status in A (0 = NERR_OK, else a
    NERR_* code). The libman dispatcher does NOT propagate a user
    function's carry flag, so consumers MUST test A, not CF.

  Memory / window discipline (enforced and documented):
    - Load the DLL into window 1 (0x4000) or window 2 (0x8000) only.
      NEVER window 3 (0xC000): the ESP backend maps the ISA UART there
      during every call and would swap its own code out. UNETESP refuses
      to initialise if it detects it was loaded into window 3.
    - All caller buffers (host/port strings, send/recv payload, GETINFO
      destinations) must live BELOW 0xC000 and OUTSIDE the 16 KB window
      the DLL was loaded into - the WHOLE buffer, not just its first byte;
      both ends of the range are validated. Violations return NERR_PARAM.
      WIN0 pointers are accepted: mapping a caller-owned page over DSS/system
      memory there, and restoring it safely, is entirely the caller's duty.
    - Host strings are limited to 128 bytes, port strings to 15 bytes
      (longer arguments return NERR_PARAM).
    - Keep at least ~256 bytes of free stack across a call.
    - The library is NOT reentrant; one call at a time.
}

unit UNet;

const
  { ABI version reported by GETCAPS in IX (major<<8 | minor) }
  UnetAbiVersion = $0100;  { ABI version reported by GETCAPS in IX (major<<8 | minor). Consumers should verify the major byte before relying on the numbered functions. }

  { Function numbers (index passed in B to l_call) }
  UnetFnInit = 0;  { libman load hook. Checks window, XOR A. Do not call directly. }
  UnetFnFini = 1;  { libman free hook. Closes any open link, A=0. Do not call directly. }
  UnetFnGetcaps = 2;  { -> A=0, DE=caps bitmask, IX=UNET_ABI_VERSION. Callable before NETINIT. }
  UnetFnNetinit = 3;  { -> A (0 / NERR_NONET / NERR_HW / NERR_BUSY). Bring the link layer up. }
  UnetFnNetdone = 4;  { Close the active channel, leave the network up. A=0. Idempotent. }
  UnetFnConnect = 5;  { A=channel, DE=host ASCIIZ, IX=port ASCIIZ -> A
  channel 0..1 when GETCAPS reports CAP_MULTICHAN,
  otherwise channel 0 only (else NERR_PARAM)
  retries internally while the backend reports "busy" }
  UnetFnSend = 6;  { A=channel, DE=buffer, IX=length -> A, DE=bytes sent
  TCP: chunked internally at 2048 (ESP-AT CIPSEND cap).
  UDP: one datagram per call, length > 1472 -> NERR_PARAM.
  Peer data arriving DURING a send may be dropped by the ESP
  backend - drain RECV before sending (see docs/UNETAPI.md).
  With UNET_OPT_SENDSLICE > 0 may return NERR_AGAIN:
  repeat the same call to continue the transaction. }
  UnetFnRecv = 7;  { A=channel, DE=buffer, IX=max, IY=timeout_ms -> A, DE=received, IX=flags
  A=NERR_OK, DE=0            : nothing for this channel yet
                               (timeout, or the backend buffered
                               data for the OTHER channel - see
                               UNET_RXF_XCHAN)
  A=NERR_CLOSED             : peer closed (any DE bytes are valid first)
  IX flags: see UNET_RXF_* below }
  UnetFnClose = 8;  { A=channel -> A. Idempotent. Closes ONE channel; use NETDONE to close every channel at once. }
  UnetFnStatus = 9;  { A=channel -> A=0, DE=state (see UNET_ST_* below)
  A=0xFF     -> network status WITHOUT touching hardware:
                A=0/NERR_NONET, DE bit0 env configured, bit1 NETINIT done }
  UnetFnUdpopen = 10;  { A=channel, DE=host, IX=rport ASCIIZ, IY=lport ASCIIZ|0 -> A
  retries internally while the backend reports "busy" }
  UnetFnResolve = 11;  { DE=host ASCIIZ, IX=dest(>=16 bytes) -> A, dest="a.b.c.d",0 }
  UnetFnPing = 12;  { DE=host ASCIIZ, IY=timeout_ms -> A, DE=round-trip ms }
  UnetFnRxpause = 13;  { drop RTS so a slow consumer can catch up -> A
  NERR_STATE before NETINIT (UART base not known yet) }
  UnetFnRxresume = 14;  { raise RTS to resume receive -> A (NERR_STATE before NETINIT) }
  UnetFnGetinfo = 15;  { A=field id, DE=dest, IX=max(incl NUL) -> A; empty string if
  unset. IX=0 -> NERR_PARAM. }
  UnetFnLasterr = 16;  { DE=dest, IX=max -> A=0; copies the TAIL of the last AT/driver
  response (the final ERROR/CLOSED line survives truncation) }
  UnetFnSetopt = 17;  { A=option id, DE=value -> A }
  UnetFnReserved18 = 18;  { reserved -> NERR_NOTSUP }
  UnetFnReserved19 = 19;
  UnetFnReserved20 = 20;
  UnetFnReserved21 = 21;
  UnetFnReserved22 = 22;
  UnetFnReserved23 = 23;
  UnetFnCount = 24;  { total slots in the jump table }

  { Error codes (returned in A). Superset of the ftpclient NERR_* set. }
  NerrOk = 0;  { success }
  NerrHw = 1;  { network hardware not found / not responding }
  NerrNonet = 2;  { network not brought up (env not published) }
  NerrDns = 3;  { host name could not be resolved }
  NerrConnect = 4;  { TCP/UDP connect failed }
  NerrSend = 5;  { send failed }
  NerrRecvTimeout = 6;  { receive timed out (reserved; RECV returns OK/DE=0 for idle) }
  NerrClosed = 7;  { connection closed by peer }
  NerrCancel = 8;  { user cancelled (Esc / Ctrl+Z) - only when SETOPT CANCELKEYS=1 }
  NerrParam = 9;  { invalid argument (bad channel, buffer out of range, ...) }
  NerrNotsup = 10;  { operation not supported by this backend/firmware }
  NerrState = 11;  { wrong state (e.g. CONNECT before NETINIT, or already open) }
  NerrTimeout = 12;  { generic operation timeout (ping / resolve) }
  NerrBusy = 13;  { backend busy (ESP IP stack still warming up) }
  NerrProto = 14;  { unexpected/protocol error in backend response }
  NerrAgain = 15;  { SEND suspended: the link was silent for one
  UNET_OPT_SENDSLICE quantum. Repeat the SAME call
  (same channel/buffer/length) to continue the
  transaction; DE = bytes confirmed so far. Only
  backends with UNET_CAP_ASYNCSEND return this. }

  { Capability bits (returned in DE by GETCAPS) }
  UnetCapTcp = 1;  { TCP client connect/send/recv/close }
  UnetCapUdp = 2;  { connected UDP }
  UnetCapResolve = 4;  { RESOLVE returns a dotted-quad (may still NERR_NOTSUP at runtime) }
  UnetCapPing = 8;  { ICMP-style ping }
  UnetCapMultichan = 16;  { channels 0 and 1 can be open at the same time (UNETESP >= 0.3; UNETRTL: 0) }
  UnetCapListen = 32;  { inbound/listen sockets (neither backend: 0) }
  UnetCapRaweth = 64;  { raw Ethernet frames (RTL only) }
  UnetCapTransparent = 128;  { ESP transparent byte-pipe mode (reserved extension) }
  UnetCapRxflow = 256;  { consumer must honour RXPAUSE/RXRESUME for lossless receive }
  UnetCapAsyncsend = 512;  { SEND can suspend with NERR_AGAIN instead of blocking (see UNET_OPT_SENDSLICE); UNETRTL: 0 }
  { UNETESP v1 advertises: TCP | UDP | RESOLVE | PING | RXFLOW = 0x010F
UNETESP v0.3 adds MULTICHAN = 0x011F
UNETESP v0.4 adds ASYNCSEND = 0x031F }

  { STATUS(channel) state bits (returned in DE) }
  UnetStConn = 2;  { channel is connected (last known state) }
  UnetStRxpend = 4;  { received data is buffered for this channel and
  not delivered yet. OPTIONAL: only backends that
  buffer per channel set it (UNETESP >= 0.3 with
  CAP_MULTICHAN); UNETRTL never does, so consumers
  must treat "not set" as "unknown", not as "empty" }

  { RECV flag bits (returned in IX) }
  UnetRxfTrunc = 1;  { oversized datagram was truncated. UNETESP never
  truncates - its tail arrives on the next call
  with UNET_RXF_MORE set. }
  UnetRxfMore = 2;  { more data is already buffered for this channel }
  UnetRxfLost = 4;  { UART overrun (LSR OE) or a dropped buffered frame
  since the last call; per channel from v0.3 }
  UnetRxfXchan = 8;  { data is pending on the OTHER channel (v0.3,
  optional). A read that returns DE=0 with this bit
  set means "switch channels", not "link idle" }

  { GETINFO field ids (A on entry) }
  UnetIfBackend = 0;  { short backend tag, e.g. "ESP" / "RTL" }
  UnetIfIp = 1;  { station IPv4, dotted quad }
  UnetIfMask = 2;  { netmask }
  UnetIfGw = 3;  { gateway }
  UnetIfMac = 4;  { station MAC }
  UnetIfDns1 = 5;  { primary DNS }
  UnetIfDns2 = 6;  { secondary DNS }
  UnetIfIpsrc = 7;  { "STATIC" / "DHCP" }
  UnetIfSsid = 8;  { Wi-Fi SSID (ESP only; empty on RTL) }
  UnetIfBaud = 9;  { UART baud (ESP only; empty on RTL) }
  UnetIfNtp = 10;  { configured NTP server }
  UnetIfTz = 11;  { timezone }
  UnetIfHw = 12;  { hardware descriptor ("<slot>/#<base>") }

  { SETOPT option ids (A) and values (DE) }
  UnetOptCancelkeys = 1;  { DE=1 poll Esc/Ctrl+Z during blocking UART loops (default 0) }
  UnetOptRxtrig = 2;  { DE=1/4/8/14 - RX FIFO auto-RTS trigger level (ESP; default 4).
  NERR_STATE before NETINIT (UART base not known yet).
  TR4 is the stable compromise: TR1 throttles ESP to ~1 KB/s,
  while TR8 leaves too little headroom and causes overruns. Use
  other values only for field diagnostics on specific hardware. }
  UnetOptSendslice = 3;  { DE=ms of link SILENCE after which SEND suspends with
  NERR_AGAIN instead of blocking (0 = blocking, the default;
  minimum 50 is enforced). Requires UNET_CAP_ASYNCSEND.
  While a send is suspended, RECV serves only already
  buffered data and returns immediately, and other
  transmitting calls return NERR_BUSY without touching
  the UART (see docs/UNETAPI.md). }

  { UNETLD loader error codes, stored in UNETLD.ERROR and returned in A on CF=1 (asm) / false (Pascal/C). }
  UnetldENoenv = 1;  { NET is not set or empty }
  UnetldEBadvalue = 2;  { NET is not 3-4 chars of [A-Z0-9] (raw value in ENV_VALUE) }
  UnetldELoad = 3;  { l_load failed (see LIBMAN.l_reason/l_dss_error/...) }
  UnetldEInfo = 4;  { l_info failed }
  UnetldEName = 5;  { the loaded DLL's L1 name does not match NET }
  UnetldECall = 6;  { libman dispatcher (CF) failure, or GETCAPS returned a non-OK status during LOAD }
  UnetldEAbi = 7;  { GETCAPS major ABI byte != HIGH(UNET_ABI_VERSION) }
  UnetldEStatus = 8;  { STATUS(0FFh) returned neither NERR_OK nor NERR_NONET }
  UnetldENetinit = 9;  { NETINIT returned a non-OK status (see LAST_STATUS) }

  { UNETLD loader state flags, stored in UNETLD.FLAGS. }
  UnetldFLoaded = 1;  { bit0 of FLAGS: DLL handle is open }
  UnetldFNetinit = 2;  { bit1 of FLAGS: NETINIT succeeded }

end.
